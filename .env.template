## ArxivDigest- environment seting 


##################################################################################################
# DO NOT COMMIT YOUR API KEYS OR EMAIL ADDRESS TO YOUR REPOSITORY 
##################################################################################################
# Use this for the default personal configs.
DEEPSEEK_API_KEY=your_deepseek_api_key # DO NOT COMMIT ANY FILE WITH THIS KEY SET

# Optional: use this only if a config sets provider: "openai".
OPENAI_API_KEY=your_openai_api_key # DO NOT COMMIT ANY FILE WITH THIS KEY SET

##  EMAIL SETTINGS
SENDGRID_API_KEY=your_api_key # DO NOT COMMIT ANY FILE WITH THIS KEY SET
FROM_EMAIL=your_email # DO NOT COMMIT ANY FILE WITH THIS KEY SET
TO_EMAIL=your_email # DO NOT COMMIT ANY FILE WITH THIS KEY SET

## SMTP SETTINGS, optional. Gmail users should use a Google App Password.
MAIL_USERNAME=your_email # DO NOT COMMIT ANY FILE WITH THIS KEY SET
MAIL_PASSWORD=your_gmail_app_password # DO NOT COMMIT ANY FILE WITH THIS KEY SET
